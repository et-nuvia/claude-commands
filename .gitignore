# Personal profile values (company domains, registries, tokens, paths)
profiles/*.yaml
!profiles/*.example.yaml
!profiles/default.yaml

# OS / editor noise
.DS_Store
Thumbs.db
*.swp
*~
.idea/
.vscode/

# Python build artifacts (from scripts/)
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Local-only overrides
commands-local/
scripts-local/
*.local.sh
*.local.md

# Secrets — should never be in here, but belt and suspenders
*.token
.credentials*
.secrets/

# Per-machine session/runtime state from track-command.sh. The tracking/
# directory has its own .gitignore for the daily JSON files inside it;
# the session file lives at the parent (~/.claude/.tracking-session)
# which equates to the repo root when CLAUDE_HOME points at the repo.
.tracking-session

# Auto-generated per-project tracking files. These are written by task
# lifecycle scripts and are noisy / conflict-prone in shared repos. They
# belong in each consuming project's .gitignore too — see
# templates/project-gitignore-snippet.txt for the canonical list.
#
# NOTE: docs/active/ and docs/completed/ are intentionally NOT ignored —
# they hold the actual task documents (TSK, FND, FIX, RCA, etc.) which
# are valuable troubleshooting context and need to be shared between
# developers.
DOCUMENT-INDEX.md
SEQUENCE-TRACKER.md
